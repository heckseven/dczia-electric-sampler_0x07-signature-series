; WS2812, one bit a loop, timed by side-set.
;
; The standard pico-examples program. Kept verbatim rather than rewritten
; because the timings are the part that matters and they are the part a rewrite
; would get subtly wrong: a WS2812 reads a bit as one or zero from how long the
; line is high, and being a few hundred nanoseconds out shows up as the wrong
; colour on some pixels and not others, depending on the batch.
;
; T1+T2+T3 cycles a bit. The clock divider in ws2812_init sets that to 1.25 us.

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1]
    jmp !x do_zero  side 1 [T1 - 1]
do_one:
    jmp bitloop     side 1 [T2 - 1]
do_zero:
    nop             side 0 [T2 - 1]
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    /* 24 bits a pixel, shifted out MSB first, autopull at 24 so the DMA can
     * hand over one word a pixel with nothing to pack. */
    sm_config_set_out_shift(&c, false, true, 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    int cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    float div = (float)clock_get_hz(clk_sys) / (800000.0f * cycles_per_bit);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
